// College Counselling Platform — Full database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// AUTH & USERS
// =====================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          String    @default("STUDENT") // STUDENT | COUNSELLOR | ADMIN
  phone         String?
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile   StudentProfile?
  applications     CounsellingApplication[]
  queries          Query[]
  queryMessages    QueryMessage[]
  leads            Lead[]                @relation("LeadAssignee")
  createdLeads     Lead[]                @relation("LeadCreator")
  notifications    Notification[]
  savedColleges    SavedCollege[]
  comparisons      CollegeComparison[]
  preferenceOrders PreferenceOrder[]
  blogPosts       BlogPost[]             @relation("BlogAuthor")
  passwordResets  PasswordReset[]
  sessions        Session[]
  accounts        Account[]

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String?
  phone           String?
  state           String?
  city            String?
  examType        String?  // JEE_MAIN | JEE_ADVANCED | NEET | GATE | Other
  examRank        String?
  examPercentile  String?
  category        String?  // General | OBC | SC | ST | EWS
  preferredCourse String?
  preferredBranch String?
  targetYear      String?
  classLevel      String?  // 12th_pass | 12th_studying | graduate
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================
// COUNSELLING PROGRAMS
// =====================================================

model CounsellingProgram {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  shortDescription String?
  description     String   // markdown / long text
  eligibility     String?
  whatIncluded    String?  // JSON array string
  benefits        String?  // JSON array string
  process         String?  // JSON array string
  duration        String?
  price           Float    @default(0)
  currency        String   @default("INR")
  isPaid          Boolean  @default(false)
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  featured        Boolean  @default(false)
  regStartDate    DateTime?
  regEndDate      DateTime?
  faqs            String?  // JSON array string of {q,a}
  heroImage       String?
  // SEO
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  ogImage         String?
  canonicalUrl    String?
  noindex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  applications    CounsellingApplication[]

  @@index([status])
  @@index([featured])
}

model CounsellingApplication {
  id              String   @id @default(cuid())
  applicationId   String   @unique // human-friendly like APP-2024-0001
  userId          String
  programId       String
  status          String   @default("SUBMITTED") // SUBMITTED | REVIEWING | APPROVED | REJECTED | ENROLLED
  paymentStatus   String   @default("NONE") // NONE | PENDING_VERIFICATION | VERIFIED | REJECTED
  // Snapshot of form data
  formData        String   // JSON string
  notes           String?
  assignedCounsellorId String?
  // UPI payment screenshot uploaded by user as proof
  paymentScreenshotUrl  String?
  paymentScreenshotName String?
  paymentNotes    String?  // User notes about the payment (e.g. UPI ref no)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         CounsellingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([programId])
  @@index([status])
  @@index([paymentStatus])
}

// =====================================================
// PREFERENCE GUIDANCE
// =====================================================

model PreferenceOrder {
  id          String   @id @default(cuid())
  userId      String
  applicationId String?
  status      String   @default("DRAFT") // DRAFT | PUBLISHED
  notes       String?
  // PDF upload - a preference order document (e.g. scanned list, signed form)
  pdfUrl      String?
  pdfName     String?
  title       String?  // Optional title for the preference order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PreferenceItem[]

  @@index([userId])
}

model PreferenceItem {
  id              String   @id @default(cuid())
  preferenceOrderId String
  rank            Int
  collegeId       String
  branchId        String?
  recommendation  String?
  notes           String?
  preferenceOrder PreferenceOrder @relation(fields: [preferenceOrderId], references: [id], onDelete: Cascade)
  college         College  @relation(fields: [collegeId], references: [id])
  branch          Branch?  @relation(fields: [branchId], references: [id])

  @@index([preferenceOrderId])
  @@index([collegeId])
}

// =====================================================
// COLLEGES & BRANCHES
// =====================================================

model College {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  shortName     String?
  description   String
  state         String
  city          String
  type          String   // GOVT | PRIVATE | DEEMED | AUTONOMOUS
  established   Int?
  website       String?
  email         String?
  phone         String?
  address       String?
  logoUrl       String?
  imageUrl     String?
  // Admission
  admissionProcess String?
  counsellingBody  String? // JoSAA | UPTAC | CSAB | State | MHT-CET | etc
  // Placement summary
  placementSummary String? // JSON {avgPackage, highestPackage, topRecruiters}
  // Fees range
  feesMin       Float?
  feesMax       Float?
  feesCurrency  String   @default("INR")
  // Rating
  rating        Float?
  // Status
  status        String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  featured      Boolean  @default(false)
  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImage        String?
  canonicalUrl   String?
  noindex        Boolean  @default(false)
  // FAQ JSON string
  faqs           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branches       Branch[]
  savedBy        SavedCollege[]
  preferenceItems PreferenceItem[]
  comparisonsA   CollegeComparison[] @relation("CompA")
  comparisonsB   CollegeComparison[] @relation("CompB")
  comparisonsC   CollegeComparison[] @relation("CompC")

  @@index([state])
  @@index([city])
  @@index([type])
  @@index([status])
  @@index([featured])
}

model Branch {
  id           String   @id @default(cuid())
  collegeId    String
  name         String   // CSE | ECE | ME | EE | CE | IT ...
  fullName     String?  // Computer Science & Engineering
  duration     String?  // 4 years
  totalSeats   Int?
  feesAnnual   Float?
  feesCurrency String   @default("INR")
  placementRate Float?  // percentage
  avgPackage   Float?
  highestPackage Float?
  topRecruiters String? // JSON array
  description  String?
  cutoffInfo   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  preferenceItems PreferenceItem[]

  @@index([collegeId])
  @@index([name])
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
}

model CollegeComparison {
  id        String   @id @default(cuid())
  userId    String
  collegeAId String
  collegeBId String?
  collegeCId String?
  name      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeA  College  @relation("CompA", fields: [collegeAId], references: [id], onDelete: Cascade)
  collegeB  College? @relation("CompB", fields: [collegeBId], references: [id], onDelete: SetNull)
  collegeC  College? @relation("CompC", fields: [collegeCId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// =====================================================
// BLOG
// =====================================================

model BlogCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       BlogPost[]
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String?
  content       String   // markdown
  featuredImage String?
  authorId      String?
  categoryId    String?
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  tags          String?  // JSON array
  tableOfContents String? // JSON array of {id, title, level}
  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImage        String?
  canonicalUrl   String?
  noindex        Boolean  @default(false)
  faqs           String? // JSON
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  author         User?        @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
}

// =====================================================
// FAQs
// =====================================================

model FAQ {
  id         String   @id @default(cuid())
  question   String
  answer     String
  category   String   // GENERAL | COUNSELLING | ADMISSION | COLLEGE | PAYMENT
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([published])
}

// =====================================================
// QUERIES / SUPPORT TICKETS
// =====================================================

model Query {
  id         String   @id @default(cuid())
  ticketId   String   @unique // TKT-2024-0001
  userId     String
  subject    String
  category   String   // GENERAL | ADMISSION | COUNSELLING | TECHNICAL | PAYMENT | OTHER
  priority   String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status     String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   QueryMessage[]

  @@index([userId])
  @@index([status])
}

model QueryMessage {
  id        String   @id @default(cuid())
  queryId   String
  userId    String?
  senderRole String  // STUDENT | ADMIN | COUNSELLOR
  message   String
  attachments String? // JSON array of {name, url}
  createdAt DateTime @default(now())
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([queryId])
}

// =====================================================
// LEADS
// =====================================================

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  source          String   @default("WEBSITE") // WEBSITE | BLOG | REFERRAL | SOCIAL | OTHER
  programInterest String?
  status          String   @default("NEW") // NEW | CONTACTED | INTERESTED | REGISTERED | CONVERTED | NOT_INTERESTED
  assignedToId    String?
  createdById     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assignedTo      User?    @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User?    @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedToId])
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | ERROR | ANNOUNCEMENT
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

// =====================================================
// TESTIMONIALS
// =====================================================

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String?  // student role / college joined
  avatar     String?
  rating     Int      @default(5)
  content    String
  college    String?  // college joined
  exam       String?  // JEE | NEET | etc
  rank       String?
  status     String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

// =====================================================
// CONTACT MESSAGES
// =====================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  source    String   @default("CONTACT_FORM")
  status    String   @default("NEW") // NEW | READ | RESPONDED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// =====================================================
// SITE SETTINGS (admin SEO controls etc.)
// =====================================================

model SiteSetting {
  id              String   @id @default("default")
  siteName        String   @default("College Counselling Hub")
  tagline         String?
  description     String?
  defaultOgImage  String?
  googleVerification String?
  robotsSetting   String   @default("index, follow")
  twitterHandle   String?
  facebookUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  youtubeUrl      String?
  linkedinUrl     String?
  contactEmail    String?
  contactPhone    String?
  whatsappNumber  String?
  whatsappMessage String?  // Pre-filled WhatsApp chat message
  upiId           String?  // Admin UPI ID for receiving payments (e.g. collegepath@upi)
  address         String?
  googleAnalyticsId String?
  updatedAt       DateTime @updatedAt
}

// =====================================================
// LIVE UPDATES (admin messages that cycle on the site)
// =====================================================

model LiveUpdate {
  id        String   @id @default(cuid())
  message   String
  link      String?  // optional URL/hash route
  icon      String?  // icon name from lucide-react
  status    String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// =====================================================
// POPUPS (admin-controlled center modal that appears once per visitor)
// =====================================================

model Popup {
  id           String   @id @default(cuid())
  title        String
  message      String
  imageUrl     String?
  ctaText      String?
  ctaLink      String?
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  showOnAllPages Boolean @default(true)
  // Frequency control
  frequency    String   @default("ONCE_PER_SESSION") // ONCE_PER_SESSION | EVERY_VISIT | DAILY | ALWAYS
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// =====================================================
// BANNERS (top announcement bar)
// =====================================================

model Banner {
  id         String   @id @default(cuid())
  message    String
  link       String?
  ctaText    String?
  variant    String   @default("info") // info | success | warning | error | brand
  dismissible Boolean @default(true)
  status     String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  order      Int      @default(0)
  startAt    DateTime?
  endAt      DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

